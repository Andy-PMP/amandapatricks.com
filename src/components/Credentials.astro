---
import { education, certifications } from '../data/resume';
---

<section class="section" id="credentials" aria-labelledby="credentials-title">
  <div class="container">
    <p class="eyebrow">Credentials</p>
    <h2 class="section-title reveal" id="credentials-title">Education &amp; certifications</h2>

    <div class="cols">
      <div class="reveal">
        <h3 class="sub">Education</h3>
        <ul class="list">
          {education.map((e) => (
            <li class="card">
              <p class="name">{e.degree}</p>
              <p class="by">{e.school}</p>
              {e.status && <p class="badge">{e.status}</p>}
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal">
        <h3 class="sub">Certifications</h3>
        <ul class="list">
          {certifications.map((c) => (
            <li class="card">
              <p class="name">{c.name}</p>
              <p class="by">{c.issuer}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cols { display: grid; gap: 2.5rem; }
  @media (min-width: 860px) { .cols { grid-template-columns: 1fr 1fr; gap: 3rem; } }
  .sub { font-family: var(--font-body); font-size: 0.8rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin: 0 0 1rem; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.2rem; }
  .card p { margin: 0; }
  .name { font-weight: 600; }
  .by { color: var(--muted); font-size: 0.92rem; }
  .badge { display: inline-block; margin-top: 0.5rem !important; font-size: 0.8rem; font-weight: 500; color: var(--accent); background: var(--accent-soft); padding: 0.2rem 0.65rem; border-radius: 999px; }

  @media print {
    .section-title { display: none; }
    .cols { grid-template-columns: 1fr 1fr; gap: 1rem; }
    .card { border: 0; padding: 0.15rem 0; }
    .badge { background: none; padding: 0; margin: 0 !important; }
  }
</style>
