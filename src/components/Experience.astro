---
import { experience } from '../data/resume';
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <p class="eyebrow">Experience</p>
    <h2 class="section-title reveal" id="experience-title">Where I’ve delivered</h2>

    <ol class="companies">
      {experience.map((co) => (
        <li class="company reveal">
          <div class="co-head">
            <h3>{co.name}</h3>
            {co.note && <p class="note">{co.note}</p>}
          </div>
          <ol class="roles">
            {co.roles.map((r) => (
              <li class="role">
                <div class="role-head">
                  <h4>{r.title}</h4>
                  <p class="dates">{r.dates}</p>
                </div>
                <ul class="bullets">
                  {r.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  ol, ul { list-style: none; margin: 0; padding: 0; }
  .company { display: grid; grid-template-columns: 1fr; gap: 0.75rem 3rem; padding-block: 2rem; border-top: 1px solid var(--line); }
  .company:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 860px) { .company { grid-template-columns: 14rem 1fr; } }

  .co-head h3 { font-size: 1.6rem; font-weight: 400; }
  .note { color: var(--muted); font-size: 0.9rem; margin: 0.25rem 0 0; }

  .roles { position: relative; }
  .role { position: relative; padding-left: 1.5rem; }
  .role + .role { margin-top: 2rem; }
  .role::before {
    content: ''; position: absolute; left: 0; top: 0.55rem; width: 9px; height: 9px;
    border-radius: 50%; background: var(--accent);
  }
  .roles:has(.role + .role)::before {
    content: ''; position: absolute; left: 4px; top: 1rem; bottom: 1rem; width: 1px; background: var(--line);
  }
  .role:last-child::before { background: var(--bg); border: 2px solid var(--accent); }
  .role:only-child::before { background: var(--accent); border: 0; }

  .role-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1rem; margin-bottom: 0.75rem; }
  h4 { font: 600 1.05rem/1.4 var(--font-body); margin: 0; }
  .dates { color: var(--muted); font-size: 0.9rem; margin: 0; font-variant-numeric: tabular-nums; }

  .bullets li { position: relative; padding-left: 1.1rem; color: var(--text); margin-bottom: 0.6rem; max-width: 72ch; }
  .bullets li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 0.45rem; height: 1px; background: var(--muted); }

  @media print {
    .company { grid-template-columns: 9rem 1fr; padding-block: 0.6rem; gap: 0.25rem 1rem; break-inside: avoid; }
    .co-head h3 { font-size: 13pt; }
    .bullets li { margin-bottom: 0.2rem; }
    .role + .role { margin-top: 0.6rem; }
  }
</style>
