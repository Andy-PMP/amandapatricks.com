---
import Icon from './Icon.astro';
import { profile } from '../data/resume';
const year = new Date().getFullYear();
---

<footer class="footer no-print" id="contact">
  <div class="container">
    <h2 class="reveal">Let’s talk.</h2>
    <p class="lede reveal">I’m open to senior program and portfolio leadership roles. The best way to reach me is by email.</p>
    <a class="email reveal" href={`mailto:${profile.email}`}>{profile.email}</a>
    <div class="row">
      <ul class="social">
        <li><a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a></li>
        <li><a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a></li>
        <li><a href={`mailto:${profile.email}`} aria-label="Email"><Icon name="mail" /></a></li>
      </ul>
      <p class="copy">© {year} {profile.name} · {profile.location}</p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: clamp(3.5rem, 8vw, 6rem) 2rem; }
  h2 { font-size: clamp(2.2rem, 6vw, 3.5rem); font-weight: 400; margin-bottom: 1rem; }
  .lede { color: var(--muted); max-width: 48ch; }
  .email {
    display: inline-block; font: 400 clamp(1.15rem, 3.4vw, 1.75rem)/1.3 var(--font-display);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 6px;
    overflow-wrap: anywhere; margin-bottom: 3.5rem;
  }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .social { display: flex; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .social a { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 999px; border: 1px solid var(--line); color: var(--text); }
  .social a:hover { border-color: var(--accent); color: var(--accent); }
  .social :global(svg) { width: 1.05rem; height: 1.05rem; }
  .copy { margin: 0; color: var(--muted); font-size: 0.88rem; }
</style>
